[Unit]
Description=PiCluster web console
After=network-online.target picluster-master.service
Wants=network-online.target picluster-master.service

[Service]
User=rpi4b-1
WorkingDirectory=/home/rpi4b-1/pi-cluster
ExecStart=/usr/bin/python3 /home/rpi4b-1/pi-cluster/webui.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
